# Install into an isolated build-owned prefix, then execute from another cwd.
set(prefix "${BUILD_DIR}/install-smoke")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${prefix}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installation failed")
endif()
foreach(binary ytcui ytcui-we)
    execute_process(COMMAND "${prefix}/bin/${binary}" --version WORKING_DIRECTORY "${prefix}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "installed ${binary} failed")
    endif()
endforeach()
foreach(asset yt.solver.core.js yt.solver.lib.js)
    if(NOT EXISTS "${prefix}/share/ytcui-we/ejs/${asset}")
        message(FATAL_ERROR "missing installed EJS asset ${asset}")
    endif()
endforeach()
